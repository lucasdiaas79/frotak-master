# Copiar para /etc/frotak/hosts.env nas duas VPS. Nao tem segredo, mas fica fora do Git.
DB_PUBLIC_IP=203.0.113.10
SERVICE_PUBLIC_IP=203.0.113.20

# Rede privada WireGuard entre as VPS.
WG_DB=10.60.0.1
WG_SERVICE=10.60.0.2

# Enderecos publicos, todos apontando para a VPS de Servico. Sem DNS proprio, sslip.io resolve
# nomes como master.203-0-113-20.sslip.io para o IP embutido e permite HTTPS de verdade.
# Trocar de endereco: editar aqui, rodar db/install.sh, service/install.sh e service/deploy-app.sh
# (o build grava as URLs publicas no pacote do navegador).
API_HOST=api.example.com
MASTER_HOST=master.example.com
TMS_HOST=app.example.com
