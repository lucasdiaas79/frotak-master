# Browser: deve apontar para o mesmo ambiente Supabase do preview atual.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server: usados para validar o JWT da Frotak IA sem service role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Somente rotinas administrativas existentes que realmente exigem service role.
SUPABASE_SERVICE_ROLE_KEY=
FROTAK_MASTER_PROVISION_TOKEN=

# Nunca habilitar em staging/preview/producao. Permite fallback SSO apenas em localhost.
VITE_ALLOW_INSECURE_LOCAL_SSO=false

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_LIVE_MODEL=
GEMINI_LIVE_VOICE=

SASCAR_WSDL_URL=https://sasintegra.sascar.com.br/SasIntegra/SasIntegraWSService?wsdl
SASCAR_USER=
SASCAR_PASSWORD=
SASCAR_SYNC_TOKEN=
